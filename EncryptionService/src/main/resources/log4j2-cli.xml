<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="OFF" monitorInterval="0">

    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd}-T%d{HH:mm.ss.SSSXXX}, Level=%-5p, Class=%c, Thread=%t, Message=[%m]%n</Property>
        <Property name="LOG_FILE">enc-cli.log</Property>
    </Properties>

    <Appenders>
        <RollingFile name="File"
                     fileName="${LOG_FILE}"
                     filePattern="${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

        <Async name="AsyncFile" includeLocation="false">
            <AppenderRef ref="File"/>
        </Async>
    </Appenders>

    <Loggers>
        <Logger name="com.example.encryption" level="INFO" additivity="false">
            <AppenderRef ref="AsyncFile"/>
        </Logger>

        <Root level="WARN">
            <AppenderRef ref="AsyncFile"/>
        </Root>
    </Loggers>

</Configuration>
